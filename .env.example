# Copy to .env.local (all optional)

# Which Claude Code to use. Leave EMPTY to auto-detect:
#   1) `claude` on PATH, else 2) the Claude Code bundled with your VS Code extension
#   (~/.vscode/extensions/anthropic.claude-code-*/resources/native-binary/claude.exe, newest version).
# It uses the same login as Claude Code in VS Code.
CLAUDE_CLI_PATH=
# Set to 0 to drop --restricted --strict-mcp-config (not recommended)
CLAUDE_RESTRICTED=1
# Model override for the CLI (empty = CLI default)
CLAUDE_MODEL=
# Seconds before a Claude call is stopped
CLAUDE_TIMEOUT_SEC=180
CLAUDE_EXTRACT_TIMEOUT_SEC=600
# Set to 0 if your CLI version does not know --include-partial-messages
CLAUDE_STREAM_PARTIAL=1
# Extra CLI flags, space separated
CLAUDE_EXTRA_ARGS=

# Data locations (relative to the project folder)
APP_DB_FILE=data/app.db
BOOKS_DIR=resources/book
BOOK_CACHE_DIR=resources/.cache
BOOK_CONTENT_DIR=content/books
